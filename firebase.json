{
  "hosting": [
    {
      "site": "thekosmix5",
      "public": "thekosmix.com",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        ".git/**",
        ".gitignore",
        "QWEN.md",
        "GEMINI.md",
        ".project"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "strollup",
      "public": "strollup.in",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        ".git/**",
        ".gitignore",
        ".project",
        "QWEN.md",
        "GEMINI.md"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "wanderindia",
      "public": "wanderindia.blog",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        ".git/**",
        ".gitignore",
        ".project",
        "QWEN.md",
        "GEMINI.md"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "kids-scroll",
      "public": "kids-scroll",
      "appAssociation": "NONE",
      "rewrites": [
        {
          "source": "/.well-known/assetlinks.json",
          "destination": "/.well-known/assetlinks.json"
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.git",
        "**/.git/**",
        "**/.githooks",
        "**/.githooks/**",
        "**/.github",
        "**/.github/**",
        "**/.antigravitycli",
        "**/.antigravitycli/**",
        "**/.claude",
        "**/.claude/**",
        "**/.auth",
        "**/.auth/**",
        "**/.gitignore",
        "**/.project",
        "**/node_modules/**",
        "**/app/**",
        "**/guideline/**",
        "**/scripts/**",
        "**/app-stores/**",
        "**/credentials/**",
        "credentials/**",
        "**/data/**",
        "data/**",
        "**/bundles/**",
        "bundles/**",
        "**/tests/**",
        "tests/**",
        "**/playwright-report/**",
        "**/test-results/**",
        "playwright.config.js",
        "package.json",
        "package-lock.json",
        "*.zip",
        "**/*.md",
        "nanobanana.txt",
        "reviews.txt",
        "video.txt",
        "LICENSE",
        "**/.env*",
        "**/*.key",
        "**/*.pem"
      ],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|eot)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp3|wav|ogg|gguf|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "service-worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Content-Type, Authorization"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "openapi.json",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, OPTIONS"
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "Content-Type, Authorization"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            }
          ]
        }
      ]
    },
    {
